[Unit]
Description=JACK Audio Daemon (headless, configurable)
After=sound.target
Wants=sound.target

[Service]
Type=simple

# Run as the normal audio user
User=pi
Group=audio

# Pull configuration from Debian-style defaults
EnvironmentFile=-/etc/default/jack

# Avoid dbus / desktop audio reservation issues
Environment=JACK_NO_AUDIO_RESERVATION=1

# Realtime scheduling + locked memory
LimitRTPRIO=95
LimitMEMLOCK=infinity
Nice=-10

# Restart behavior (USB DACs may enumerate late)
Restart=on-failure
RestartSec=2
StartLimitIntervalSec=30
StartLimitBurst=5

ExecStart=/usr/local/bin/jack-start

[Install]
WantedBy=multi-user.target
