[Unit]
Description=SFZ Router (load mod-host chain from JSON)
After=mod-host.service jack.service sound.target
Wants=mod-host.service jack.service
PartOf=jack.service mod-host.service
BindsTo=jack.service mod-host.service

[Service]
Type=simple

User=pi
Group=audio

# Allow realtime priority + memory locking
LimitRTPRIO=95
LimitMEMLOCK=infinity
LimitNOFILE=1048576

KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=15

WorkingDirectory=/opt/router
EnvironmentFile=-/etc/default/router-loader

# Make LV2 discovery consistent with your mod-host setup (optional but recommended)
#Environment=LV2_PATH=/usr/local/lib/lv2:/usr/lib/lv2:/home/pi/.lv2

Environment=ROUTER_CONFIG=/opt/router/jsons/wah.json
ExecStart=/usr/bin/python3 -n /opt/router/load_single.py ${ROUTER_CONFIG}

# Small delay to avoid racing mod-host/JACK port creation
#ExecStartPre=/bin/sleep 2
ExecStartPre=/bin/bash -lc 'for i in $(seq 1 50); do nc -z 127.0.0.1 5555 && exit 0; sleep 0.1; done; echo "mod-host not ready" >&2; exit 1'
#ExecStart=/usr/bin/python3 -u /opt/router/load_single.py "${ROUTER_CONFIG:-/opt/router/jsons/wah.json}"

Restart=on-failure
RestartSec=2

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
