[Unit]
Description=SFZ Router (load mod-host chain from JSON)
After=mod-host.service jack.service sound.target
Wants=mod-host.service jack.service
PartOf=jack.service mod-host.service
BindsTo=jack.service mod-host.service

[Service]
Type=simple

User=pi
Group=audio

# Allow realtime priority + memory locking
LimitRTPRIO=95
LimitMEMLOCK=infinity
LimitNOFILE=1048576

KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=15

WorkingDirectory=/opt/router

EnvironmentFile=-/etc/default/router-loader
Environment=ROUTER_CONFIG=/opt/router/jsons/default.json
ExecStartPre=/bin/bash -lc 'for i in $(seq 1 50); do nc -z 127.0.0.1 5555 && exit 0; sleep 0.1; done; echo "mod-host not ready" >&2; exit 1'
ExecStart=/usr/bin/python3 -u /opt/router/load_single.py $ROUTER_CONFIG

Restart=on-failure
RestartSec=2

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
